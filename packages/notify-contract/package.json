{
  "name": "@syna-demo/notify-contract",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Syna example fixture: the Notifier Contract of the notification delivery service (fictional domain)",
  "imports": {
    "#syna/package": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "syna": {
    "id": "demo.notify.contract",
    "metadata": {
      "displayName": "Notify contract",
      "description": "The capability of delivering a notification, shared by every provider client"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@syna/core": "1.0.0-rc.5"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@syna/tsconfig": "1.0.0-rc.5"
  }
}
