{
  "name": "@syna-demo/logger",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Syna example fixture: shared logging infrastructure of the notification delivery service (fictional domain)",
  "imports": {
    "#syna/package": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "syna": {
    "id": "demo.logger",
    "metadata": {
      "displayName": "Logger",
      "description": "Shared infrastructure: one sink per world, closed by its owner"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@syna/core": "1.0.0-rc.4"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@syna/tsconfig": "1.0.0-rc.4"
  }
}
