{
  "extends": "@synajs/tsconfig/node-library.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../notify-contract"
    },
    {
      "path": "../tenant-store"
    },
    {
      "path": "../logger"
    }
  ]
}
