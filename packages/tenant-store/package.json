{
  "name": "@syna-demo/tenant-store",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Syna example fixture: the tenant store of the notification delivery service, a fake connection pool over a directory (fictional domain)",
  "imports": {
    "#syna/package": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "syna": {
    "id": "demo.tenant-store",
    "metadata": {
      "displayName": "Tenant store",
      "description": "Tenants and their settings behind a fake connection pool"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@syna-demo/logger": "1.1.0",
    "syna": "1.0.0-rc.1"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@synajs/tsconfig": "1.0.0-rc.1"
  }
}
