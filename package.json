{
  "name": "syna-workspace",
  "private": true,
  "type": "module",
  "version": "1.0.0-rc.4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synajs/syna.git"
  },
  "homepage": "https://github.com/synajs/syna#readme",
  "bugs": {
    "url": "https://github.com/synajs/syna/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "clean": "find packages apps -type d -name dist -prune -exec rm -rf {} + && find packages apps -name '*.tsbuildinfo' -delete",
    "build": "tsc -b packages/core --force && tsc -b tsconfig.json --force",
    "typecheck": "tsc -b tsconfig.json --pretty false && npm run type-tests",
    "type-tests": "tsc -p packages/core/tsconfig.type-tests.json --pretty false",
    "test": "npm run build && node --test packages/core/tests/*.test.mjs",
    "test:app": "node --test apps/multitenant-blog/tests/filesystem.test.mjs apps/multitenant-blog/tests/render.test.mjs apps/multitenant-blog/tests/tenants-auth.test.mjs apps/multitenant-blog/tests/preflight.test.mjs apps/multitenant-blog/tests/audit-app.test.mjs apps/multitenant-blog/tests/review-app.test.mjs apps/multitenant-blog/tests/rc3-close-paths.test.mjs apps/multitenant-blog/tests/rc4-acquire-deadline.test.mjs && node --test --expose-gc apps/multitenant-blog/tests/site-manager.test.mjs",
    "test:postgres": "node scripts/pg-test-cluster.mjs with -- node --test apps/multitenant-blog/tests/postgres.test.mjs apps/multitenant-blog/tests/matrix.test.mjs",
    "test:scripts": "node --test scripts/tests/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage packages/core/tests/*.test.mjs",
    "demo:01": "node apps/01-basics/dist/index.js",
    "demo:02": "node apps/02-per-tenant/dist/index.js",
    "demo:03": "node apps/03-user-configurable/dist/index.js",
    "demo:04": "node apps/04-two-versions/dist/index.js",
    "demo:05": "node apps/05-scheduled-jobs/dist/index.js",
    "demo:06": "node apps/06-testing/dist/index.js",
    "demo:07": "node apps/07-failure-modes/dist/index.js",
    "demo:multitenant-blog": "node apps/multitenant-blog/bin/multitenant-blog.mjs demo --root ./work/demo-content",
    "demo": "npm run build && npm run demo:01 && npm run demo:02 && npm run demo:03 && npm run demo:04 && npm run demo:05 && npm run demo:06 && npm run demo:07",
    "check": "npm run typecheck && npm test && npm run test:app && npm run test:scripts && npm run demo",
    "benchmark:v05": "npm run build && node --expose-gc benchmarks/v0.5-planning.mjs benchmarks/results-v0.5.0.json",
    "benchmark:v04-workload": "npm run build && node --expose-gc benchmarks/v0.4-planning.mjs benchmarks/results-v0.4-workload-on-v0.5-same-machine.json",
    "verify": "node scripts/verify-release.mjs --dev",
    "verify:release": "node scripts/verify-release.mjs --release",
    "verify:v08": "node scripts/verify-v08.mjs --dev",
    "verify:v07": "node scripts/verify-v07.mjs --dev",
    "verify:v06": "node scripts/verify-v06.mjs --dev",
    "verify:v05": "node scripts/verify-v05.mjs --dev"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "description": "Syna core, the seven examples and the multitenant-blog reference application",
  "devDependencies": {
    "@types/node": "^22.19.7",
    "typescript": "~5.9.3"
  }
}
