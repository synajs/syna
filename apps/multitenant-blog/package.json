{
  "name": "@syna-app/multitenant-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "multitenant-blog: the reference application of Syna \u2014 a narrow but complete multi-tenant blog engine (real PostgreSQL and filesystem backends, dynamic HTTP and static builds)",
  "imports": {
    "#syna/package": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "multitenant-blog": "./bin/multitenant-blog.mjs"
  },
  "syna": {
    "id": "hyla.mini",
    "metadata": {
      "displayName": "multitenant-blog"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/filesystem.test.mjs tests/render.test.mjs tests/tenants-auth.test.mjs tests/preflight.test.mjs && node --test --expose-gc tests/site-manager.test.mjs",
    "test:postgres": "node ../../scripts/pg-test-cluster.mjs with -- node --test tests/postgres.test.mjs tests/matrix.test.mjs"
  },
  "dependencies": {
    "@syna/core": "1.0.0-rc.5",
    "ajv": "^8.20.0",
    "pg": "^8.23.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@syna/tsconfig": "1.0.0-rc.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/pg": "^8.23.1",
    "@types/unist": "^3.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
